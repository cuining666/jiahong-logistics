---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = '江苏嘉弘国际货运代理有限公司 — 专业国际货运代理，提供海运、空运、陆运、仓储、堆场等一条龙进出口物流服务。' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="logo" href="/">
          <span class="logo-mark">JH</span>
          <span class="logo-text">江苏嘉弘国际货运代理</span>
        </a>
        <nav class="nav">
          <a href="/">首页</a>
          <a href="/about">关于我们</a>
          <a href="/offerings">服务介绍</a>
          <a href="/contact">联系我们</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot-grid">
        <div>
          <div class="logo">
            <span class="logo-mark">JH</span>
            <span class="logo-text">江苏嘉弘国际货运代理</span>
          </div>
          <p class="foot-about">国家一级货运代理，提供全方位的国内和国际贸易运输服务。</p>
        </div>
        <div>
          <h4>快速链接</h4>
          <ul>
            <li><a href="/">首页</a></li>
            <li><a href="/about">关于我们</a></li>
            <li><a href="/offerings">服务介绍</a></li>
            <li><a href="/contact">联系我们</a></li>
          </ul>
        </div>
        <div>
          <h4>联系方式</h4>
          <ul class="foot-info">
            <li>地址：江苏省张家港市凤凰镇长江路8号</li>
            <li>电话：+86 180 1361 3114</li>
            <li>邮箱：X_kenny@yeah.net</li>
          </ul>
        </div>
      </div>
      <div class="container copyright">© {year} 江苏嘉弘国际货运代理有限公司. 保留所有权利.</div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: saturate(180%) blur(8px);
        border-bottom: 1px solid var(--line);
      }
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }
      .logo { display: flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 700; }
      .logo:hover { text-decoration: none; }
      .logo-mark {
        width: 34px; height: 34px;
        display: grid; place-items: center;
        background: var(--brand); color: #fff;
        border-radius: 8px; font-size: .9rem; font-weight: 700;
      }
      .logo-text { font-size: 1rem; }
      .nav { display: flex; gap: 28px; }
      .nav a { color: var(--ink); font-weight: 500; font-size: .95rem; }
      .nav a:hover { color: var(--brand); text-decoration: none; }

      .site-footer { background: var(--brand-dark); color: #cfe0f2; margin-top: 0; padding: 56px 0 24px; }
      .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1.4fr; gap: 32px; }
      .site-footer .logo { color: #fff; }
      .site-footer .logo-mark { background: #fff; color: var(--brand-dark); }
      .foot-about { color: #a9c2dd; font-size: .92rem; margin-top: 12px; max-width: 320px; }
      .site-footer h4 { color: #fff; font-size: .98rem; margin-bottom: 14px; }
      .site-footer ul { list-style: none; padding: 0; margin: 0; }
      .site-footer li { margin-bottom: 8px; font-size: .9rem; }
      .site-footer a { color: #cfe0f2; }
      .site-footer a:hover { color: #fff; }
      .foot-info li { color: #a9c2dd; }
      .copyright { border-top: 1px solid rgba(255,255,255,.12); margin-top: 36px; padding-top: 20px; font-size: .82rem; color: #8fb0d2; }

      @media (max-width: 860px) {
        .nav { gap: 16px; font-size: .85rem; }
        .logo-text { display: none; }
        .foot-grid { grid-template-columns: 1fr; gap: 24px; }
      }
    </style>
  </body>
</html>

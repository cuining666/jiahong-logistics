---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  lang="en"
  title="About Us - Jiangsu Jiahong Int'l Freight Forwarding"
  description="Learn about Jiangsu Jiahong's four service principles, core values and partners. A Class I licensed forwarder with contracts with 12 carriers."
>
  <!-- Page hero -->
  <section class="page-hero has-img warehouse">
    <div class="container">
      <div class="breadcrumb"><a href="/en">Home</a> / About</div>
      <h1>Professional Freight Forwarding</h1>
      <p>Our story — four service principles that make us your trusted logistics partner.</p>
    </div>
  </section>

  <!-- Company intro -->
  <section class="section">
    <div class="container about-grid">
      <div class="reveal">
        <span class="eyebrow" style="color:var(--accent);font-weight:700;letter-spacing:2px;">ABOUT US</span>
        <h2>Our Story</h2>
        <p>Jiangsu Jiahong is a <strong>Class I licensed freight forwarder</strong>, serving traders and manufacturers with professionalism and integrity under four service principles.</p>
        <p>With contracts with 12 major carriers, a 20,000㎡ modern warehouse, 5 container yards and 60 own trucks, we run an integrated sea/land/air/warehousing/customs network.</p>
        <ul class="about-list">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Class I Freight Forwarder License</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Contracts with 12 Carriers</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>96.88% Customs Clearance Rate</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>7×24 Warehouse & Yard Ops</li>
        </ul>
      </div>
      <img
        class="about-photo reveal"
        data-delay="120"
        src="/images/truck-fleet.webp"
        alt="Jiahong cross-border truck fleet"
      />
    </div>
  </section>

  <!-- Four principles -->
  <section class="section soft">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">OUR PRINCIPLES</span>
        <h2>Four Service Principles Since Day One</h2>
        <p>Always there · Best service · Best price · Problem-solving.</p>
      </div>
      <div class="philosophy">
        <div class="item reveal">
          <div class="k">Principle 01</div>
          <h4>Always There</h4>
          <p>Quotes whenever you need them, fastest response; issues handled promptly and resolved.</p>
        </div>
        <div class="item reveal" data-delay="80">
          <div class="k">Principle 02</div>
          <h4>Best Service</h4>
          <p>From booking, customs, warehousing to sailing and arrival, we track and report to clients in real time.</p>
        </div>
        <div class="item reveal" data-delay="160">
          <div class="k">Principle 03</div>
          <h4>Best Price</h4>
          <p>Contracts with 12 carriers; volume earns our best rates, among the market leaders.</p>
        </div>
        <div class="item reveal" data-delay="240">
          <div class="k">Principle 04</div>
          <h4>Problem-Solving</h4>
          <p>Container shortages and sailings are manageable, inspections coordinated; 96.88% clearance rate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core values -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">CORE VALUES</span>
        <h2>Core Values</h2>
        <p>Our core values show in the promise and service to every client.</p>
      </div>
      <div class="values">
        <div class="v reveal">
          <div class="ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3 7 7 .5-5.5 4.5 2 7L12 17l-6.5 4 2-7L2 9.5 9 9l3-7Z"/></svg></div>
          <h4>Excellence</h4>
          <p>We are committed to excellent service and valuable logistics solutions for our clients.</p>
        </div>
        <div class="v reveal" data-delay="100">
          <div class="ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4Z"/></svg></div>
          <h4>Professionalism</h4>
          <p>Our expert team provides professional domestic and international transport services.</p>
        </div>
        <div class="v reveal" data-delay="200">
          <div class="ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
          <h4>Trust</h4>
          <p>Built on integrity and reliability, we earn our clients' trust and satisfaction.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="section soft">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">PARTNERS</span>
        <h2>Our Partners</h2>
        <p>We are proud to partner with industry leaders to drive innovation and mutual success.</p>
      </div>
      <div class="partners reveal">
        <div class="p">Maersk</div>
        <div class="p">MSC</div>
        <div class="p">CMA CGM</div>
        <div class="p">COSCO</div>
        <div class="p">Evergreen</div>
        <div class="p">OOCL</div>
        <div class="p">SITC</div>
        <div class="p">Yang Ming</div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-band">
    <div class="container">
      <h2>Want to Know Jiahong Better?</h2>
      <p>Our team is ready to provide a company introduction and tailored logistics consulting.</p>
      <a href="/en/contact" class="btn btn-primary">Contact Us →</a>
    </div>
  </section>
</Layout>

---
import { getLocale, useTranslations, localize } from '../i18n/ui';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const base = path.replace(/^\/en/, '') || '/';

const navItems = [
  { href: localize('/', locale), label: t('nav.home') },
  { href: localize('/about', locale), label: t('nav.about') },
  { href: localize('/services', locale), label: t('nav.services') },
  { href: localize('/contact', locale), label: t('nav.contact') },
];

const brand = locale === 'zh'
  ? { cn: '江苏嘉弘国际货运', en: "Jiangsu Jiahong Int'l Freight" }
  : { cn: 'Jiangsu Jiahong', en: "Int'l Freight Forwarding" };
---

<header class="site-header">
  <div class="container nav">
    <a href={localize('/', locale)} class="brand">
      <img src="/images/logo-mark.png" alt="嘉弘物流标志" class="logo-mark" width="188" height="160" loading="eager" />
      <span class="brand-text">
        <span class="cn">{brand.cn}</span>
        <span class="en">{brand.en}</span>
      </span>
    </a>
    <nav class="nav-links" id="navLinks">
      {navItems.map((item) => (
        <a href={item.href} class={path === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      <a href={localize('/contact', locale)} class="btn btn-primary nav-cta">{t('cta.quote')}</a>
    </nav>
    <div class="lang-switch" aria-label="Language">
      <a href={localize(base, 'zh')} class={locale === 'zh' ? 'active' : ''} hreflang="zh-CN">中文</a>
      <span class="sep">/</span>
      <a href={localize(base, 'en')} class={locale === 'en' ? 'active' : ''} hreflang="en">EN</a>
    </div>
    <button class="nav-toggle" aria-label="菜单">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

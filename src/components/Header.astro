---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于我们' },
  { href: '/services', label: '产品服务' },
  { href: '/contact', label: '联系我们' },
];
---

<header class="site-header">
  <div class="container nav">
    <a href="/" class="brand">
      <img src="/images/logo-mark.png" alt="嘉弘物流标志" class="logo-mark" width="188" height="160" loading="eager" />
      <span class="brand-text">
        <span class="cn">江苏嘉弘国际货运</span>
        <span class="en">Jiangsu Jiahong Int'l Freight</span>
      </span>
    </a>
    <nav class="nav-links" id="navLinks">
      {navItems.map((item) => (
        <a href={item.href} class={path === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      <a href="/contact" class="btn btn-primary nav-cta">获取报价</a>
    </nav>
    <button class="nav-toggle" aria-label="菜单">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于我们' },
  { href: '/services', label: '产品服务' },
  { href: '/contact', label: '联系我们' },
];
---

<header class="site-header">
  <div class="container nav">
    <a href="/" class="brand">
      <svg class="logo-mark" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="22" stroke="#5cb3f0" stroke-width="2.5"/>
        <path d="M6 24h36M24 6c6 6 6 30 0 36M24 6c-6 6-6 30 0 36" stroke="#5cb3f0" stroke-width="2"/>
        <path d="M11 16h26l-4 6 4 6H11l4-6-4-6Z" fill="#1f8fd6"/>
      </svg>
      <span class="brand-text">
        <span class="cn">江苏嘉弘国际货运</span>
        <span class="en">Jiangsu Jiahong Int'l Freight</span>
      </span>
    </a>
    <nav class="nav-links" id="navLinks">
      {navItems.map((item) => (
        <a href={item.href} class={path === item.href ? 'active' : ''}>{item.label}</a>
      ))}
      <a href="/contact" class="btn btn-primary nav-cta">获取报价</a>
    </nav>
    <button class="nav-toggle" aria-label="菜单">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
